/*6.2按钮栏*/
ImageTwoDialog QFrame#frame_ToolLeft,
ImageTwoDialog QFrame#frame_frame_ToolRight,
ImageTwoDialog QFrame#frame_VLine{
	max-height:50px;
	min-height:50px;
}
ImageTwoDialog QFrame#frame_VLine{
	border-left:2px solid #c8cddc;
	border-top:0px solid red;
	border-right:0px solid red;
	border-bottom:0px solid red;
}


