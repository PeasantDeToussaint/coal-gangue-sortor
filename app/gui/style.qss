/*公共下拉列表框样式*/
QComboBox {
	background-color:#eef0f8;
	border:1px solid #e6e6f0;
	color:#4b5055;
	font-size:12px;
}

QComboBox:editable {
	background: white;
}

QComboBox:!editable, QComboBox::drop-down:editable {
	background-color:#eef0f8;
}

QComboBox:!editable:on, QComboBox::drop-down:editable:on {
	background-color:#eef0f8;
}

QComboBox:on { 
	/*padding-top: 3px;
	padding-left: 4px;*/
	border:1px solid #1e78f0;/*有下拉框时，控制边框颜色*/
}

QComboBox::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: top right;
  width: 20px;

  border-left-width: 0px;
  border-left-color: darkgray;
  border-left-style: solid; 
  border-top-right-radius: 3px; 
  border-bottom-right-radius: 3px;
}

QComboBox::down-arrow {
	image: url(./image/TabWidget/三角-可点击.png);
}

QComboBox::down-arrow:on { 
	image: url(./image/TabWidget/三角-点击.png);
}
QComboBox::down-arrow:disabled{
    image: url(./image/TabWidget/三角-不可点击.png);
}

QComboBox QAbstractItemView {
    border: 1px solid #c8cddc;
	background-color:#f8fdff;
	/*注意：QComboBox的下拉列表间距调整存在问题，即设置margin-left后，下拉列表左侧存在背景无法消除问题
	所以解决方法是在ui界面中设置布局的spacing为10，达到ui效果的，所以这个间距需要在ui界面中调整spacing参数值
	*/
}
QComboBox QAbstractItemView::item {
	min-height: 24px; 
	max-height: 24px;
	/*注意：这个item高度要想生效，必须在ui的构造函数中调用comboxObj.setView(new QListView())方法*/
}
QComboBox QAbstractItemView::item:selected {
	color:#ffffff;
    background-color:#1e78f0;
}

