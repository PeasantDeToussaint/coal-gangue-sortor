/*联锁状态*/
CommonWidget QCheckBox#checkBox_InterlockState{
	margin-top:10px;
	margin-bottom:10px;
}
CommonWidget QCheckBox#checkBox_InterlockState::indicator:disabled {
	image: url(./image/CommonWidget/状态-灰.png);
}
CommonWidget QCheckBox#checkBox_InterlockState::indicator:unchecked {
	image: url(./image/CommonWidget/状态-灰.png);
}
CommonWidget QCheckBox#checkBox_InterlockState::indicator:checked {
	image: url(./image/CommonWidget/真空状态.png);
}
/*灯丝状态*/
CommonWidget QCheckBox#checkBox_FilamentState{
	margin-top:10px;
	margin-left:30px;
	margin-bottom:10px;
}
CommonWidget QCheckBox#checkBox_FilamentState::indicator:disabled {
	image: url(./image/CommonWidget/状态-灰.png);
}
CommonWidget QCheckBox#checkBox_FilamentState::indicator:unchecked {
	image: url(./image/CommonWidget/状态-灰.png);
}
CommonWidget QCheckBox#checkBox_FilamentState::indicator:checked {
	image: url(./image/CommonWidget/真空状态.png);
}
/*冷气状态*/
CommonWidget QCheckBox#checkBox_CoolState{
	margin-top:10px;
	margin-left:30px;
	margin-bottom:10px;
}
CommonWidget QCheckBox#checkBox_CoolState::indicator:disabled {
	image: url(./image/CommonWidget/状态-灰.png);
}
CommonWidget QCheckBox#checkBox_CoolState::indicator:unchecked {
	image: url(./image/CommonWidget/状态-灰.png);
}
CommonWidget QCheckBox#checkBox_CoolState::indicator:checked {
	image: url(./image/CommonWidget/真空状态.png);
}
/*真空状态*/
CommonWidget QCheckBox#checkBox_VacuoState{
	margin-top:10px;
	margin-left:30px;
	margin-bottom:10px;
}
CommonWidget QCheckBox#checkBox_VacuoState::indicator:disabled {
	image: url(./image/CommonWidget/状态-灰.png);
}
CommonWidget QCheckBox#checkBox_VacuoState::indicator:unchecked {
	image: url(./image/CommonWidget/状态-灰.png);
}
CommonWidget QCheckBox#checkBox_VacuoState::indicator:checked {
	image: url(./image/CommonWidget/真空状态.png);
}

/*第3行到第6行*/
CommonWidget QLineEdit#lineEdit_SetVoltage,
CommonWidget QLineEdit#lineEdit_SetPower,
CommonWidget QLineEdit#lineEdit_CurrentVoltage,
CommonWidget QLineEdit#lineEdit_CurrentPower,
CommonWidget QLineEdit#lineEdit_CurrentRunTime,
CommonWidget QLineEdit#lineEdit_TotalRunTime{
	min-width:66px;
	max-width:66px;
	min-height:30px;
	max-height:30px;
	margin-top:10px;
	margin-left:10px;
}
CommonWidget QLineEdit#lineEdit_CurrentPower,
CommonWidget QLineEdit#lineEdit_TotalRunTime{
	margin-bottom:10px;
}
/*滑动条*/
/*首先是设置主体*/
QSlider{
	border-color: #e1e6f0;
	/*border:1px solid red;*/
	margin-top:15px;
}
QSlider::groove:horizontal {                                
    border: 0px solid #e1e6f0;                             
    height: 10px;                                           
    margin: 0px 0;                                         
    left: 10px; 
	right: 10px;
	border-radius: 5px; 
 }
 /*设置中间的那个滑动的键*/ 
QSlider::handle:horizontal {                               
    border: 1px solid #ffffff;                           
    border-image:  url(./image/CommonWidget/圆-未点击时.png);
    /*min-width: 16px;
	max-width: 16px;
	min-height: 16px;
	max-height: 16px;
    margin: -2px -10px -5px -10px; */    

	width: 16px;  
    height: 16px;  
    margin: -4px 0px -4px 0px;  
    border-radius:11px;  
	
	/*width: 16px;  
    margin-top: -5px;  
    margin-bottom: -5px;  
	margin-left:-1px;
	margin-right:-1px;
    border-radius: 5px;  	*/
} 
QSlider::handle:horizontal:pressed {                               
    border: 1px solid #ffffff;                           
    border-image:  url(./image/CommonWidget/圆-点击时.png);
    /*min-width: 16px;
	max-width: 16px;
	min-height: 16px;
	max-height: 16px;
    margin: -2px -10px -5px -10px; */    

	width: 16px;  
    height: 16px;  
    margin: -4px 0px -4px 0px;  
    border-radius:11px;  
	
	/*width: 16px;  
    margin-top: -5px;  
    margin-bottom: -5px;  
	margin-left:-1px;
	margin-right:-1px;
    border-radius: 5px;  	*/
} 
/*还没有滑上去的地方*/
QSlider::add-page:horizontal{
	background: #e1e6f0; 
	border-radius: 5px; 
}
/*已经划过的从地方*/
QSlider::sub-page:horizontal{                               
	background: #1e78f0; 
	border-radius: 5px; 	
}
/*第7行载物台*/
CommonWidget QFrame#frame_Stage{
	background-color:#e1e6f0;
	min-height:26px;
	max-height:26px;
	margin-top:10px;
}
CommonWidget QLabel#label_Stage{
	margin-top:0px;
	margin-left:10px;
}
/*第8行 xyz参数*/
CommonWidget QFrame#frame_StageParams{
	border:1px solid #e1e6f0;
	padding-left:20px;
	padding-top:6px;
	padding-right:20px;
	padding-bottom:5px;
}
CommonWidget QLabel#label_X,
CommonWidget QLabel#label_Y,
CommonWidget QLabel#label_Z{
	margin-top:0px;
}
CommonWidget QLineEdit#lineEdit_X,
CommonWidget QLineEdit#lineEdit_Y,
CommonWidget QLineEdit#lineEdit_C{
	min-width:80px;
	max-width:80px;
	min-height:30px;
	max-height:30px;
	margin-left:10px;
}
/*第9行角度*/
CommonWidget QLabel#label_DetectorRotatedAngle,
CommonWidget QLabel#label_DetectorTiltedAngle{
	margin-bottom:10px;
}
CommonWidget QLineEdit#lineEdit_DetectorRotatedAngle,
CommonWidget QLineEdit#lineEdit_DetectorTiltedAngle{
	min-width:50px;
	max-width:50px;
	min-height:30px;
	max-height:30px;
	margin-left:10px;
	margin-top:10px;
	margin-bottom:10px;
}
/*第10行样品高度*/
CommonWidget QLineEdit#lineEdit_SampleHeight{
	min-width:49px;
	max-width:49px;
	min-height:30px;
	max-height:30px;
	margin-left:10px;
	margin-top:10px;
}
/*分割线*/
CommonWidget QFrame#frame_line,
CommonWidget QFrame#frame_line2,
CommonWidget QFrame#frame_line3{
	border-top: 1px solid #ebf0f5;
}

/*5、主窗口图像区域*/
/*5.1图像区域*/
ImageWidget QFrame#frame_Image{
	border:2px solid #c8cddc;
	/*background-color:#e1e6f0;*/
	/*padding-top:20px;
	padding-bottom:20px;*/
	margin-top:20px;
	margin-bottom:20px;
	margin-left:2px;
	margin-right:2px;
	background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,stop: 0 #e1e6f0, stop: 0.5 #ffffff, stop: 1 #e1e6f0);
}
ImageWidget QFrame#frame_Image_2{
	border:2px solid #c8cddc;
	/*background-color:#e1e6f0;*/
	/*padding-top:20px;
	padding-bottom:20px;*/
	margin-top:20px;
	margin-bottom:20px;
	margin-left:2px;
	margin-right:2px;
	background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,stop: 0 #e1e6f0, stop: 0.5 #ffffff, stop: 1 #e1e6f0);
}
ImageWidget QFrame#frame_Image_3{
	border:2px solid #c8cddc;
	/*background-color:#e1e6f0;*/
	/*padding-top:20px;
	padding-bottom:20px;*/
	margin-top:20px;
	margin-bottom:20px;
	margin-left:2px;
	margin-right:2px;
	background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,stop: 0 #e1e6f0, stop: 0.5 #ffffff, stop: 1 #e1e6f0);
}
ImageWidget QFrame#frame_Image:hover{
	border:2px solid #1e78f0;
}
ImageWidget QFrame#frame_Image_2:hover{
	border:2px solid #1e78f0;
}
ImageWidget QFrame#frame_Image_3:hover{
	border:2px solid #1e78f0;
}
/*5.2位置区域*/
ImageWidget QFrame#frame_Position{
	border-right:2px solid #c8cddc;
	background-color:#f8fdff;
	padding-right:20px;
	min-height:30px;
	max-height:30px;
	margin-left:2px;
	margin-right:2px;
}
ImageWidget QLabel#label_X,
ImageWidget QLabel#label_Y,
ImageWidget QLabel#label_Result{
	margin-left:15px;
}
ImageWidget QLabel#label_X,
ImageWidget QLabel#label_XValue,
ImageWidget QLabel#label_Y,
ImageWidget QLabel#label_YValue,
ImageWidget QLabel#label_Result,
ImageWidget QLabel#label_ResultValue{
	color:#4a4d54;
	font-size:12px;
}

/*6、副屏幕图像区域*/
/*6.1图像区域*/
ImageTwoDialog QFrame#frame_ImageLeft{
	border:2px solid #c8cddc;
	/*background-color:#e1e6f0;*/
	margin:2px 1px 2px 2px;
	background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,stop: 0 #e1e6f0, stop: 0.5 #ffffff, stop: 1 #e1e6f0);
}
ImageTwoDialog QFrame#frame_ImageRight{
	border:2px solid #c8cddc;
	/*background-color:#e1e6f0;*/
	margin:2px 2px 2px 1px;
	background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,stop: 0 #e1e6f0, stop: 0.5 #ffffff, stop: 1 #e1e6f0);
}
