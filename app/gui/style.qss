*{
	/*color:red;*/
	font-family: "微软雅黑";
}
QFrame#frameMainBackground{
	background-color:#d7dce6;
}
/*1--菜单栏样式*/
QFrame#topFrame_menubar{
	max-height:42px;
	min-height:42px;
	background-color:#f8fdff;
	border-bottom:1px solid #e6eaf5;
}
QToolButton#tbnLogo{
	border-image:url(./image/logo.png);
	max-height:42px;
	min-height:42px;
	margin-left:15px;
}
QMenuBar{
	font-size:15px;
	background-color:#f8fdff;
	border-bottom:1px solid #e6eaf5;
}
QMenuBar::item { 
	color:#4a4d54;
	border:0px solid yellow;
	padding-left:15px;
	padding-top:11px;
	padding-bottom:10px;
	padding-right:15px;
	border:0px solid green;
}
QMenuBar::item:selected { 
    background-color: #1E78F0;
	color:#ffffff;
}
QMenuBar::item:pressed {
	background-color: #1E78F0;
	color:#ffffff;
}

QMenu{
    background-color:#f8fdff;
    border: 1px solid #ebf0f5;
}

QMenu::item {
	background-color:#f8fdff;
	max-height:32px;
	min-height:32px;
	color:#4a4d54;
	border:0px solid green;/*这句不能省，否则高度不起作用，不知道为什么*/
	width:150px;/*效果图236px*/
	padding-left:20px;
	padding-right:20px;
	margin-top:2px;
	margin-bottom:2px;
}

QMenu::item:selected { 
	background-color: #1E78F0;
	color:#ffffff;
}
/*titlebar*/
QFrame#titleBarFrame{
	min-height:40px;
	max-height:40px;
	background-color:#f8fdff;
}
QToolButton#tbnMin{
	border-image: url(./image/Navigation/最小化-未点击.png);
	min-width:60px;
	max-width:60px;
	min-height:30px;
	max-height:30px;
}
QToolButton#tbnMin:hover{
	border-image: url(./image/Navigation/最小化-点击.png);
}
QToolButton#tbnMin:pressed{
	border-image: url(./image/Navigation/最小化-点击.png);
}
QToolButton#tbnResize{
	border-image: url(./image/Navigation/最大化-未点击.png);
	min-width:60px;
	max-width:60px;
	min-height:30px;
	max-height:30px;
}
QToolButton#tbnResize:hover{
	border-image: url(./image/Navigation/最大化-点击加底.png);
}
QToolButton#tbnResize:pressed{
	border-image: url(./image/Navigation/最大化-点击加底.png);
}
QToolButton#tbnClose{
	border-image: url(./image/Navigation/关闭-未点击.png);
	min-width:60px;
	max-width:60px;
	min-height:30px;
	max-height:30px;
	margin-left:1px;
	margin-right:10px;
}
QToolButton#tbnClose:hover{
	border-image: url(./image/Navigation/关闭-点击加底.png);
}
QToolButton#tbnClose:pressed{
	border-image: url(./image/Navigation/关闭-点击加底.png);
}
/*2--工具栏按钮样式*/
/*背景*/
ToolWidget QFrame#ToolWidgetframe{
	background-color:#f8fdff;
	min-height:50px;
	max-height:50px;
	padding-right:20px;
}
/*分割线*/
ToolWidget QFrame#frame_line0,
ToolWidget QFrame#frame_line,
ToolWidget QFrame#frame_line2,
ToolWidget QFrame#frame_line3,
ToolWidget QFrame#frame_line4{
	border-top:0px solid red;
	border-left:0px solid red;
	border-bottom:0px solid red;
	border-right:1px solid #ebf0f5;
	min-height:36px;
	max-height:36px;
}

/*保存*/
ToolWidget QToolButton#tbnSave{
    border-image: url(./image/ToolWidget/保存-可点击.png);
