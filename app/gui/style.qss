	border-image:url(./image/CommonWidget/关门icon.png);
	background-color:#eef0f8;
	color:#ffffff;
}
CommonWidget QToolButton#toolButton_OpenDoor:disabled{
	border-image:url(./image/CommonWidget/关门icon.png);
	background-color:#eef0f8;
}
