# Build
build/
build-*/
cmake-build-*/
out/
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.exe
*.exp
*.pdb
*.ilk
# *.lib: NOT globally excluded — Windows import libraries (.lib) in third_party/ are
# needed for linking on the production machine and ARE committed intentionally.
# Only exclude specific DLLs (runtime binaries, too large/OS-specific for git).
*.dll

# IDE
.vscode/
.idea/
*.user
*.user.*
*.suo
*.vcxproj.user
.DS_Store
Thumbs.db

# Qt qmake artifacts
Makefile
Makefile.*
debug/
release/
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qm
.qmake.cache
.qmake.stash

# CMake artifacts
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json

# Vendor SDK binaries
# Aurora SDK: runtime DLLs/LIBs excluded, headers tracked
third_party/aurora-sdk/lib/XLibDll.dll
third_party/aurora-sdk/lib/XLibDll.lib
third_party/aurora-sdk/lib/debug/
# Beckhoff ADS open-source: cloned externally at build time, not committed
third_party/ads/
# Vendor runtime DLLs — NOT committed (copy from E:\Gangue\ at deployment).
# The .lib import libraries ARE committed — they are needed to link on Windows.
third_party/detectorlib/DetectorLib.dll
third_party/xraylib/XRayLib.dll
third_party/beckofflib/BeckHoffLib.dll
third_party/plccontrollib/PLCControlLib.dll
third_party/qtopencv/Qt_OpenCV_Image_Processing.dll

# Machine-specific config (copy from config.example.xml and edit)
config/config.xml

# Detector calibration model (mode.txt) IS committed — same format across machines.
# It contains per-pixel gain/offset for flat-field correction (2180 rows × 2 values).
# Regenerate by running 暗场校正 + 亮场校正 on-site after detector setup.

# Test TIFF frames — large (5MB each), exclude from git.
tests/test_frame.tif
tests/test_gpu_frame.tif

# Calibration images — large binaries, machine-specific (5-8 MB each).
# calibrateImageXray.tif and calibrateImageCamera.png are copied from
# the production machine's Gangue/config/ folder — do NOT commit them.
config/calibrateImageXray.tif
config/calibrateImageCamera.png

# CCF files (Hikvision camera config, ~7 KB) ARE committed — they are
# small and identical across all machines using the Linea C4096-7um sensor.
# config/T_Linea_C4096-7um_Internal.ccf  ← tracked (do not exclude)
# config/T_Linea_C4096-7um_External.ccf  ← tracked (do not exclude)

# AI model weights — GPU-specific, large, generated by trtexec / training.
# Commit only the loading code; never commit model binaries.
*.onnx
*.trt
*.engine
*.wts
*.pt
*.pth

# Sensitive runtime data
config/config.local.xml
data/
logs/
recordings/
*.bin
*.raw
*.pcap

# Python (tools/)
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Temp
*.tmp
*.bak
*.swp
*~
build-manual/
*.o
